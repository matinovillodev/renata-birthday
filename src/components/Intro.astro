---
/**
 * Opening curtain ("Abrir invitación") that covers the hero.
 *
 * Progressive enhancement: it is NOT rendered visibly by default, so without
 * JavaScript the invitation is fully visible and scrollable. The inline
 * bootstrap adds `intro` to <html> (plain visits only); src/scripts/intro.ts
 * wires `[data-intro-open]`, bursts from `[data-intro-burst]` and removes it.
 *
 * Background: a blurred, darkened copy of the hero photo (decorative), laid
 * over exactly the hero's box. It uses the hero's own renditions
 * (`<Hero photoOnly />`), so the browser downloads the photo once. On open the
 * curtain fades while the copy settles to the hero's scale, so the sharp hero
 * underneath "comes into focus" (src/scripts/animations.ts).
 * Motion hooks: `[data-intro-camera]` (idle zoom, focus pull) and the CSS fireflies.
 */
import { copy } from '../data/event';
import Hero from './Hero.astro';
import StarIcon from './StarIcon.astro';

/** Firefly positions (% of the screen), sizes (px) and timings (s), fixed for stable markup. */
const FIREFLIES = [
  [8, 18, 4, 11, -2], [22, 72, 5, 13, -7], [31, 9, 3, 9, -4], [44, 84, 4, 12, -1],
  [57, 22, 5, 14, -9], [66, 63, 3, 10, -3], [78, 12, 4, 12, -6], [88, 47, 5, 13, -11],
  [14, 41, 3, 10, -5], [36, 57, 4, 11, -8], [51, 37, 3, 9, -2], [72, 88, 4, 14, -10],
  [93, 77, 3, 11, -4], [4, 90, 5, 12, -7],
] as const;
---

<div class="intro" data-intro>
  <div class="intro__scene" aria-hidden="true">
    <div class="intro__backdrop" data-intro-bg>
      <div class="intro__camera" data-intro-camera>
        <Hero photoOnly />
      </div>
    </div>
    <div class="intro__shade"></div>
    <div class="intro__fireflies" data-intro-fireflies>
      {
        FIREFLIES.map(([left, top, size, duration, delay]) => (
          <span
            class="firefly"
            style={`left: ${left}%; top: ${top}%; --size: ${size}px; --drift: ${duration}s; --delay: ${delay}s`}
          />
        ))
      }
    </div>
  </div>

  <div class="intro__emblem">
    <StarIcon size={64} color="var(--color-gold)" class="intro__star" />
    <div class="intro__burst" data-intro-burst aria-hidden="true"></div>
  </div>
  <p class="eyebrow intro__eyebrow">{copy.intro.eyebrow}</p>
  <p class="display intro__name">{copy.intro.name}</p>
  <button type="button" class="btn btn--light intro__open" data-intro-open>
    <svg
      viewBox="0 0 24 24"
      width="22"
      height="22"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 7l9 6 9-6"></path></svg
    >
    {copy.intro.openButton}
  </button>
</div>

<style>
  .intro {
    display: none;
  }

  /*
   * Fixed (V3 used absolute): the curtain keeps covering the viewport even if
   * something scrolls the locked page underneath it (e.g. a programmatic
   * scroll), so the guest never sees half a curtain.
   */
  :global(html.intro) .intro {
    position: fixed;
    inset: 0;
    z-index: 40;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 24px;
    overflow: hidden;
    background: var(--color-forest);
    color: var(--color-ivory);
    text-align: center;
  }

  /* Content sits above the scene. */
  .intro > :not(.intro__scene) {
    position: relative;
    z-index: 1;
  }

  .intro__eyebrow,
  .intro__name {
    text-shadow: 0 1px 3px rgb(var(--tint-forest) / 0.5);
  }

  .intro__scene {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* Exactly the hero's box: its sticky screen at the top of the page. */
  .intro__backdrop {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    height: var(--screen-height);
    overflow: hidden;
  }

  /*
   * Same transform origin (center) as the hero photo. Scale = the hero photo's
   * own scale at the top of the page (1 without motion; 1.14 portrait or 1.06
   * landscape with motion, see animations.ts) times a small bleed that keeps
   * the blur's soft edges off-screen. GSAP starts from these same values.
   */
  .intro__camera {
    --hero-zoom: 1;
    --edge-bleed: 1.12;
    position: absolute;
    inset: 0;
    transform: scale(calc(var(--hero-zoom) * var(--edge-bleed)));
    will-change: transform;
  }

  @media (prefers-reduced-motion: no-preference) {
    .intro__camera {
      --hero-zoom: 1.14;
    }
  }

  @media (prefers-reduced-motion: no-preference) and (min-aspect-ratio: 4/3) {
    .intro__camera {
      --hero-zoom: 1.06;
    }
  }

  .intro__camera :global(img) {
    filter: blur(28px);
  }

  /*
   * V3 forest tint: uniform 55%, an ellipse behind the text up to ~87%, and
   * a vignette that darkens the edges. Measured worst case (95th percentile
   * of the pixels behind the text, blurred "Luz de hadas" photo, 360x640 to
   * 1920x1080 and a rotated phone): eyebrow 4.71:1, name 5.44:1.
   */
  .intro__shade {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 45% at 50% 50%, rgb(var(--tint-forest) / 0.7), rgb(var(--tint-forest) / 0)),
      radial-gradient(ellipse 90% 80% at 50% 50%, rgb(var(--tint-forest) / 0) 60%, rgb(var(--tint-forest) / 0.6)),
      rgb(var(--tint-forest) / 0.55);
  }

  /* Fireflies: warm glowing dots that drift and twinkle (transform/opacity only). */
  .intro__fireflies {
    position: absolute;
    inset: 0;
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .intro__fireflies {
      display: block;
    }
  }

  .firefly {
    position: absolute;
    width: var(--size);
    height: var(--size);
    border-radius: 50%;
    background: var(--color-gold-light);
    box-shadow: 0 0 calc(var(--size) * 2) calc(var(--size) / 2) rgb(243 223 166 / 0.6);
    opacity: 0;
    animation:
      firefly-drift var(--drift) ease-in-out var(--delay) infinite alternate,
      firefly-glow calc(var(--drift) / 3) ease-in-out var(--delay) infinite;
  }

  @keyframes firefly-drift {
    0% {
      transform: translate(0, 0);
    }

    50% {
      transform: translate(14px, -22px);
    }

    100% {
      transform: translate(-10px, -40px);
    }
  }

  @keyframes firefly-glow {
    0%,
    100% {
      opacity: 0.15;
    }

    50% {
      opacity: 0.95;
    }
  }

  .intro__emblem {
    position: relative;
    width: 64px;
    height: 64px;
  }

  .intro__emblem :global(.intro__star) {
    filter: drop-shadow(0 0 16px rgb(216 183 106 / 0.7));
  }

  /* Burst origin at the star's center; T3 renders the sparkles inside. */
  .intro__burst {
    position: absolute;
    top: 32px;
    left: 32px;
    width: 0;
    height: 0;
  }

  .intro__eyebrow {
    margin-top: 12px;
    font-size: 13px;
    letter-spacing: 0.18em;
    color: var(--color-gold);
  }

  .intro__name {
    font-size: 76px;
    font-style: italic;
    line-height: 1;
    color: var(--color-pink-light);
  }

  .intro__open {
    margin-top: 32px;
    box-shadow: 0 0 32px rgb(216 183 106 / 0.35);
  }
</style>
