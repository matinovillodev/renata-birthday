---
/**
 * "Sábado 28 de noviembre · 13:30 hs". Each label stays on one line and the
 * "·" separator travels with the time, so narrow screens wrap as
 * "Sábado 28 de noviembre" / "· 13:30 hs" (never a dangling "·" or "hs").
 */
import { copy } from '../data/event';
import type { EventDateLabels } from '../lib/event-date';

interface Props {
  date: EventDateLabels;
}

const { date } = Astro.props;
---

<span class="nowrap">{date.dayLabel}</span>{' '}<span class="nowrap"
  >{copy.dateTimeSeparator.trimStart()}{date.timeLabel}</span
>

<style>
  .nowrap {
    white-space: nowrap;
  }
</style>
