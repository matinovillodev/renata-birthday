---
/**
 * "Sábado 28 de noviembre · 13:30 hs". Each label stays on one line, so on
 * narrow screens the line wraps after the separator instead of leaving "hs"
 * (or a lone number) on its own line.
 */
import { copy } from '../data/event';
import type { EventDateLabels } from '../lib/event-date';

interface Props {
  date: EventDateLabels;
}

const { date } = Astro.props;
---

<span class="nowrap">{date.dayLabel}{copy.dateTimeSeparator.trimEnd()}</span>{' '}<span
  class="nowrap">{date.timeLabel}</span>

<style>
  .nowrap {
    white-space: nowrap;
  }
</style>
