---
/**
 * RSVP sheet (#confirmar): opens WhatsApp with a pre-filled message. The page
 * never says the RSVP was sent. The default slot renders after the button
 * (the closing footer).
 *
 * It is the `#confirmar` anchor target (hero CTA, side nav, shared links) and
 * the last section, sized to its content (no forced screen height): a jump to
 * it scrolls to the end of the page, where the whole panel, WhatsApp button
 * included, sits in view under the top of the chapter photo. Taller than the
 * screen (a rotated phone), its top reaches the top of the viewport and the
 * button is still in view.
 */
import { copy } from '../data/event';
import StarIcon from './StarIcon.astro';

interface Props {
  /** wa.me link built from the event data. */
  whatsappUrl: string;
}

const { whatsappUrl } = Astro.props;
---

<section id="confirmar" class="sheet sheet--cream rsvp" aria-labelledby="rsvp-title">
  <div class="rsvp__cta">
    <div class="rsvp__stars" aria-hidden="true">
      <StarIcon size={12} color="var(--color-gold)" />
      <StarIcon size={20} color="var(--color-gold)" />
      <StarIcon size={12} color="var(--color-gold)" />
    </div>
    <h2 id="rsvp-title" class="display sheet__title rsvp__title">{copy.rsvp.heading}</h2>
    <a class="btn rsvp__whatsapp" href={whatsappUrl} target="_blank" rel="noopener" data-rsvp-link>
      <svg
        viewBox="0 0 24 24"
        width="22"
        height="22"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"><path d="M4 19.5l1.3-3.9A8 8 0 1 1 8.4 18.7L4 19.5z"></path></svg
      >
      {copy.rsvp.button}
    </a>
  </div>
  <slot />
</section>

<style>
  .rsvp__cta {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .rsvp__stars {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 10px;
  }

  .rsvp__title {
    margin-top: 16px;
  }

  /*
   * One line down to 360 px phones (272 px between the gutters): a slightly
   * smaller label, tighter padding, and an icon that never shrinks.
   */
  .rsvp__whatsapp {
    margin-top: 32px;
    padding: 0 24px;
    font-size: 17px;
    white-space: nowrap;
    background: var(--color-moss);
    color: var(--color-white);
    box-shadow: 0 10px 24px rgb(var(--tint-moss) / 0.28);
  }

  .rsvp__whatsapp svg {
    flex: none;
  }

  .rsvp__whatsapp:hover {
    color: var(--color-white);
  }
</style>
