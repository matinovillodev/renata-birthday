---
/**
 * Fixed side navigation: one thin dash per section, each a real link with a
 * 44x44px hit area. Text blocks keep a 44px side gutter (--gutter) so the
 * hit areas never sit on top of text.
 *
 * T3 hook: set `aria-current="true"` on the link of the section in view
 * (scroll spy); that link renders as the wide gold dash.
 */
import { copy } from '../data/event';
---

<nav class="side-nav" aria-label={copy.nav.ariaLabel}>
  <ul class="side-nav__list">
    {
      copy.nav.items.map((item) => (
        <li>
          <a class="side-nav__link" href={`#${item.id}`} title={item.label} data-nav-link={item.id}>
            <span class="side-nav__dash" aria-hidden="true" />
            <span class="visually-hidden">{item.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .side-nav {
    position: fixed;
    top: 50%;
    right: 0;
    z-index: 35;
    transform: translateY(-50%);
    /* A tight dark rim plus a soft halo keeps the light dashes visible over the cream and
       peach panels, the bright hero veil and the dark chapter photos alike. */
    filter: drop-shadow(0 0 1px rgb(var(--tint-dark) / 0.9)) drop-shadow(0 0 3px rgb(var(--tint-dark) / 0.45));
  }

  .side-nav__list {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .side-nav__link {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    width: var(--tap-size);
    height: var(--tap-size);
    padding-right: 10px;
  }

  .side-nav__dash {
    display: block;
    width: 12px;
    height: 2px;
    border-radius: 2px;
    background: rgb(var(--tint-cream) / 0.8);
    transition:
      width 0.3s ease,
      background-color 0.3s ease;
  }

  .side-nav__link:hover .side-nav__dash,
  .side-nav__link:focus-visible .side-nav__dash {
    width: 20px;
  }

  .side-nav__link[aria-current='true'] .side-nav__dash {
    width: 26px;
    background: var(--color-gold);
  }

  @media (prefers-reduced-motion: reduce) {
    .side-nav__dash {
      transition: none;
    }
  }
</style>
