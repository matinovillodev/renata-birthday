---
/**
 * Chapter I hero (#inicio screen): full-bleed photo of Renata with the
 * invitation headline at the bottom.
 *
 * T3 hooks: `data-parallax="photo"` on the picture, `data-twinkle` stars,
 * `data-rise` on the text stack (V3 staggers its children in after the intro).
 *
 * `photoOnly` renders just the hero photo with the very same renditions, as a
 * decorative copy for the intro curtain: identical sources mean the browser
 * downloads the photo once.
 */
import type { ComponentProps } from 'astro/types';
import heroLandscape from '../assets/photos/hero-landscape.jpg';
import heroPortrait from '../assets/photos/hero-portrait.jpg';
import { copy } from '../data/event';
import type { EventDateLabels } from '../lib/event-date';
import ArtDirectedPhoto from './ArtDirectedPhoto.astro';
import DateLine from './DateLine.astro';
import PhotoScreen from './PhotoScreen.astro';
import StarIcon from './StarIcon.astro';

type Props =
  | {
      /** Day and time labels derived from the event data. */
      date: EventDateLabels;
      photoOnly?: false;
    }
  | { photoOnly: true; date?: undefined };

const props = Astro.props;

/*
 * The hero renditions drop the top of each photo (background only) so that
 * Renata's face sits higher on screen and the text below never covers it.
 * Landscape: 0.14 together with the softer 1.06 zoom (animations.ts) and the
 * 18svh name cap below keeps the headband ~40px from the top and the chin
 * above the text on 1440x900, 1280x800 and 1024x768.
 */
const PORTRAIT_TOP_CROP = 0.12;
const LANDSCAPE_TOP_CROP = 0.14;

/** Single source of the hero photo renditions (hero and intro curtain). */
const photo: Pick<ComponentProps<typeof ArtDirectedPhoto>, 'switchAt' | 'narrow' | 'wide'> = {
  switchAt: '4/3',
  narrow: {
    src: heroPortrait,
    aspectRatio: heroPortrait.width / (heroPortrait.height * (1 - PORTRAIT_TOP_CROP)),
    cropPosition: 'bottom',
    widths: [640, 828, 1080, 1290, 1602],
    sizes: 'max(100vw, min(76vh, 836px))',
    objectPosition: '50% 30%',
  },
  wide: {
    src: heroLandscape,
    aspectRatio: heroLandscape.width / (heroLandscape.height * (1 - LANDSCAPE_TOP_CROP)),
    cropPosition: 'bottom',
    widths: [960, 1280, 1600, 1920, 2400],
    sizes: 'max(100vw, min(176vh, 1938px))',
    objectPosition: '50% 30%',
  },
};

const twinkles = [
  { left: '12%', top: '16%', size: 18, delay: '-0.4s' },
  { left: '80%', top: '12%', size: 14, delay: '-1.1s' },
  { left: '70%', top: '32%', size: 20, delay: '-1.9s' },
  { left: '20%', top: '40%', size: 12, delay: '-2.6s' },
];
---

{
  props.photoOnly ? (
    <ArtDirectedPhoto {...photo} priority alt="" data-hero-copy="" />
  ) : (
<PhotoScreen variant="hero">
  <ArtDirectedPhoto slot="photo" {...photo} priority alt={copy.hero.photoAlt} data-parallax="photo" />

  <Fragment slot="decor">
    {
      twinkles.map((star) => (
        <span
          class="twinkle"
          data-twinkle
          style={`left: ${star.left}; top: ${star.top}; --twinkle-delay: ${star.delay}`}
          aria-hidden="true"
        >
          <StarIcon size={star.size} color="var(--color-gold-light)" />
        </span>
      ))
    }
  </Fragment>

  <div class="hero" data-rise>
    <p class="eyebrow hero__eyebrow">{copy.hero.eyebrow}</p>
    <h1 class="display hero__name" tabindex="-1">{copy.hero.name}</h1>
    <p class="hero__date"><DateLine date={props.date} /></p>
    <a class="btn btn--light hero__cta" href="#confirmar">{copy.hero.rsvpButton}</a>
    <p class="hero__hint">
      <svg
        viewBox="0 0 24 24"
        width="16"
        height="16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"><path d="M12 5v14M6 13l6 6 6-6"></path></svg
      >
      {copy.hero.scrollHint}
    </p>
  </div>
</PhotoScreen>
  )
}

<style>
  .twinkle {
    position: absolute;
    display: block;
    filter: drop-shadow(0 0 6px rgb(255 236 180 / 0.9));
    pointer-events: none;
  }

  /* V3 twinkle (CSS only, so it needs no script and honors reduced motion). */
  @media (prefers-reduced-motion: no-preference) {
    .twinkle {
      animation: twinkle 3.2s ease-in-out infinite;
      animation-delay: var(--twinkle-delay, 0s);
    }
  }

  @keyframes twinkle {
    0%,
    100% {
      opacity: 0.25;
      transform: scale(0.75);
    }

    50% {
      opacity: 1;
      transform: scale(1.1);
    }
  }

  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    max-width: 960px;
    margin: 0 auto;
  }

  .hero__eyebrow {
    color: var(--color-gold-light);
  }

  .hero__name {
    font-size: clamp(88px, 24vw, 200px);
    font-style: italic;
    line-height: 0.9;
    letter-spacing: -0.01em;
    color: var(--color-pink-light);
  }

  /* Cap the name by the screen height so the text stack stays below the face. */
  @supports (height: 100svh) {
    .hero__name {
      font-size: clamp(64px, min(max(88px, 24vw), 20svh), 200px);
    }

    /* Landscape shows more of the photo above the face (smaller top crop). */
    @media (min-aspect-ratio: 4/3) {
      .hero__name {
        font-size: clamp(64px, min(max(88px, 24vw), 18svh), 200px);
      }
    }
  }

  .hero__date {
    margin-top: 6px;
    font-size: 20px;
    font-weight: 600;
  }

  .hero__cta {
    margin-top: 10px;
  }

  /* The arrow flows inline so it stays next to the text when the hint wraps. */
  .hero__hint {
    margin-top: 18px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .hero__hint svg {
    display: inline-block;
    margin-right: 10px;
    vertical-align: -3px;
  }

  @media (max-aspect-ratio: 4/3) and (max-height: 700px) {
    .hero {
      gap: 8px;
    }

    .hero__hint {
      margin-top: 10px;
    }
  }
</style>
