---
/**
 * #el-gran-dia: peach sheet that says the day, time and place in one
 * sentence (built from `event`, also the section heading), then "Cómo llegar"
 * (#como-llegar) with the map preview (VenueMap.astro).
 */
import { copy } from '../data/event';
import type { EventDatePhrases } from '../lib/event-date';
import StarIcon from './StarIcon.astro';
import VenueMap from './VenueMap.astro';

interface Props {
  /** Date phrases derived from the event data. */
  date: EventDatePhrases;
}

const { date } = Astro.props;
---

<section id="el-gran-dia" class="sheet sheet--peach details" aria-labelledby="el-gran-dia-title">
  <h2 id="el-gran-dia-title" class="display details__sentence">{copy.details.sentence(date)}</h2>

  <div class="details__divider" aria-hidden="true">
    <span></span>
    <StarIcon size={14} color="var(--color-gold)" />
    <span></span>
  </div>

  <h3 id="como-llegar" class="display details__map-title">{copy.map.heading}</h3>
  <VenueMap />
</section>

<style>
  /*
   * The facts as a sentence set like the body of a printed card: Fraunces at
   * reading-display size, balanced lines that break only between phrases.
   */
  .details__sentence {
    max-width: 16em;
    margin: 0 auto;
    font-size: clamp(30px, 7.4vw, 54px);
    font-weight: 400;
    line-height: 1.2;
    text-wrap: balance;
    color: var(--color-cocoa);
  }

  .details__divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    max-width: 280px;
    margin: 64px auto 0;
  }

  .details__divider span {
    flex: 1 1 0;
    height: 1px;
    background: var(--color-gold);
  }

  .details__map-title {
    margin-top: 28px;
    font-size: 32px;
    line-height: 1.2;
    color: var(--color-cocoa);
  }
</style>
