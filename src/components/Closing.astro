---
/**
 * Closing footer at the end of the RSVP sheet: only the farewell. The date
 * and place are said once, in the details sentence, not repeated here.
 */
import { copy } from '../data/event';
---

<footer class="closing">
  <p class="display closing__title">{copy.closing.heading}</p>
</footer>

<style>
  .closing {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 720px;
    margin: 0 auto;
    padding: clamp(64px, 8vw, 96px) 0 clamp(72px, 7vw, 96px);
  }

  /* Line-height 1.1 keeps the italic descenders ("p") clear of the sheet's bottom padding. */
  .closing__title {
    font-size: clamp(52px, 14vw, 104px);
    font-style: italic;
    line-height: 1.1;
    color: var(--color-accent);
  }
</style>
