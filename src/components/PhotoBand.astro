---
/**
 * Decorative photo band between chapters I and II: two rows of rounded
 * thumbnails (3:4 and 4:3). Hidden from assistive technology, as in V3.
 *
 * Thumbnails are cropped at build time to their box ratio, so each unique
 * thumbnail is downloaded once at a small size (repeats reuse the same URL).
 *
 * T3 hooks: `data-parallax="strip"` and `data-parallax="strip-reverse"` move
 * the rows horizontally in opposite directions while scrolling.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import bandLandscape from '../assets/photos/band-landscape.jpg';
import closingLandscape from '../assets/photos/closing-landscape.jpg';
import heroLandscape from '../assets/photos/hero-landscape.jpg';
import heroPortrait from '../assets/photos/hero-portrait.jpg';

/*
 * Crop anchors are sharp keywords (percentages are not supported). `center`
 * keeps Renata in frame for every crop except the portrait photo in a wide
 * box, where `top` keeps her whole head.
 */
interface Thumb {
  src: ImageMetadata;
  tallPosition: 'center' | 'top';
  widePosition: 'center' | 'top';
}

const portrait: Thumb = { src: heroPortrait, tallPosition: 'center', widePosition: 'top' };
const band: Thumb = { src: bandLandscape, tallPosition: 'center', widePosition: 'center' };
const closing: Thumb = { src: closingLandscape, tallPosition: 'center', widePosition: 'center' };
const landscape: Thumb = { src: heroLandscape, tallPosition: 'center', widePosition: 'center' };

const THUMB_WIDTH = 340;
const widths = [240, 340, 480, 680];
const sizes = 'clamp(160px, 24vw, 340px)';

// Each row repeats its four photos twice, as in V3, so it can slide sideways.
const rows = [
  { parallax: 'strip', shape: 'tall', ratio: 3 / 4, thumbs: [portrait, band, closing, landscape] },
  { parallax: 'strip-reverse', shape: 'wide', ratio: 4 / 3, thumbs: [closing, landscape, band, portrait] },
].map((row) => ({ ...row, thumbs: [...row.thumbs, ...row.thumbs] }));
---

<div class="band" data-chapter="2" aria-hidden="true">
  {
    rows.map((row) => (
      <div class="band__row" data-parallax={row.parallax}>
        {row.thumbs.map((thumb) => (
          <Picture
            src={thumb.src}
            alt=""
            formats={['avif', 'webp']}
            width={THUMB_WIDTH}
            height={Math.round(THUMB_WIDTH / row.ratio)}
            widths={widths}
            sizes={sizes}
            fit="cover"
            position={row.shape === 'tall' ? thumb.tallPosition : thumb.widePosition}
            loading="lazy"
            decoding="async"
            class:list={['band__thumb', `band__thumb--${row.shape}`]}
          />
        ))}
      </div>
    ))
  }
</div>

<style>
  .band {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 72px 0;
    overflow: hidden;
    background: var(--color-dark);
  }

  .band__row {
    display: flex;
    gap: 16px;
    width: max-content;
  }

  .band__row :global(picture) {
    flex: none;
  }

  .band__row :global(.band__thumb) {
    display: block;
    width: clamp(160px, 24vw, 340px);
    height: auto;
    object-fit: cover;
    border-radius: var(--radius-thumb);
  }

  .band__row :global(.band__thumb--tall) {
    aspect-ratio: 3 / 4;
  }

  .band__row :global(.band__thumb--wide) {
    aspect-ratio: 4 / 3;
  }
</style>
