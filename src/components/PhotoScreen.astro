---
/**
 * Sticky full-screen photo with text anchored to the bottom (V3 "scr").
 * The next sibling sheet scrolls over it.
 *
 * Slots: `photo` (an ArtDirectedPhoto), `decor` (decorative overlays such as
 * twinkles) and the default slot (the text block).
 *
 * T3 hooks: `data-screen` on the sticky box, `data-parallax="float"` on the
 * text block (V3 moves it up and fades it while scrolling).
 */
interface Props {
  /** `hero`: dark copy over a cream veil or halo (bright photo); `chapter`: V3's dark gradient and spacing. */
  variant: 'hero' | 'chapter';
}

const { variant } = Astro.props;
---

<div class:list={['screen', `screen--${variant}`]} data-screen>
  <slot name="photo" />
  <div class="screen__shade" aria-hidden="true"></div>
  <slot name="decor" />
  <div class="screen__copy" data-parallax="float">
    <slot />
  </div>
</div>

<style>
  .screen {
    position: sticky;
    top: 0;
    z-index: 0;
    height: var(--screen-height);
    overflow: hidden;
    background: var(--color-dark);
    color: var(--color-cream);
  }

  .screen__shade {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .screen--chapter .screen__shade {
    background: linear-gradient(180deg, rgb(var(--tint-dark) / 0) 40%, rgb(var(--tint-dark) / 0.72) 100%);
  }

  .screen__copy {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 1;
    padding: 0 var(--gutter) 80px;
    text-align: center;
    text-shadow: 0 1px 3px rgb(var(--tint-dark) / 0.35);
  }

  /*
   * Text-anchored scrim (not in V3): darkens only the band behind the text,
   * fading in above it, so light text keeps AA contrast on any photo area.
   */
  .screen__copy::before {
    content: '';
    position: absolute;
    inset: calc(-1 * var(--scrim-fade)) 0 0;
    z-index: -1;
    background: linear-gradient(
      180deg,
      rgb(var(--tint-dark) / 0) 0,
      rgb(var(--tint-dark) / var(--scrim-alpha)) var(--scrim-fade),
      rgb(var(--tint-dark) / var(--scrim-alpha)) 100%
    );
    pointer-events: none;
  }

  /*
   * Hero ("Luz de hadas" photo, bright): dark copy. Portrait screens keep it
   * at the bottom over a cream veil anchored to the text, so the veil never
   * washes over Renata's face; the photo is lifted above it (Hero.astro).
   * The veil turns solid where the lifted photo ends (`--hero-lift`).
   */
  .screen--hero {
    background: var(--color-cream);
    color: var(--color-cocoa);
  }

  .screen--hero .screen__copy {
    padding-bottom: 72px;
    text-shadow: none;
  }

  /* Eased fade: it stays faint over the chin (just above the text) and firms up behind the eyebrow. */
  .screen--hero .screen__copy::before {
    inset: calc(-1 * var(--veil-fade)) 0 0;
    background: linear-gradient(
      180deg,
      rgb(var(--tint-cream) / 0) 0,
      rgb(var(--tint-cream) / 0.12) calc(var(--veil-fade) * 0.45),
      rgb(var(--tint-cream) / 0.45) calc(var(--veil-fade) * 0.75),
      rgb(var(--tint-cream) / var(--veil-alpha)) var(--veil-fade),
      rgb(var(--tint-cream) / var(--veil-alpha-bottom)) calc(100% - var(--hero-lift, 0px) - 24px),
      rgb(var(--tint-cream) / 1) calc(100% - var(--hero-lift, 0px))
    );
  }

  @media (max-aspect-ratio: 4/3) and (max-height: 700px) {
    .screen--hero .screen__copy {
      padding-bottom: 28px;
    }
  }

  /*
   * Landscape: the copy sits centered in the right half, over the photo's
   * clear haze, with a soft cream halo behind it instead of the veil.
   */
  @media (min-aspect-ratio: 4/3) {
    .screen--hero .screen__shade {
      background: radial-gradient(
        ellipse 40% 60% at 74% 50%,
        rgb(var(--tint-cream) / var(--halo-alpha)) 0%,
        rgb(var(--tint-cream) / calc(var(--halo-alpha) * 0.45)) 55%,
        rgb(var(--tint-cream) / 0) 100%
      );
    }

    .screen--hero .screen__copy {
      top: 0;
      right: 3%;
      left: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px 0;
    }

    .screen--hero .screen__copy::before {
      content: none;
    }
  }
</style>
