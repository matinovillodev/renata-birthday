---
/**
 * Document shell: language, SEO/sharing meta, self-hosted fonts and tokens.
 * The page is not meant to be found by search engines (noindex), but it is
 * shared by link, so it carries Open Graph and Twitter card previews.
 */
import { Font } from 'astro:assets';
import { bootstrapScript } from '../scripts/bootstrap';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Social preview image (1200x630), as an absolute URL. */
  image: { url: string; alt: string; width: number; height: number };
}

const { title, description, image } = Astro.props;
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Before first paint: html.js, and html.intro unless this is a deep link (src/scripts/bootstrap.ts). -->
    <script is:inline set:html={bootstrapScript} />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1e2a22" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- The hero (and the intro) use Fraunces italic and Nunito: preload only those. -->
    <Font cssVariable="--font-display" preload={[{ style: 'italic' }]} />
    <Font cssVariable="--font-body" preload />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image.url} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={String(image.width)} />
    <meta property="og:image:height" content={String(image.height)} />
    <meta property="og:image:alt" content={image.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image.url} />
    <meta name="twitter:image:alt" content={image.alt} />
  </head>
  <body>
    <slot />
  </body>
</html>
