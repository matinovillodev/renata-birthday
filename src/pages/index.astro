---
/**
 * The invitation: V3 "Inmersiva con parallax", static layer.
 * Every text and fact comes from src/data/event.ts.
 *
 * Section anchors (side nav targets): #inicio, #invitacion, #el-gran-dia,
 * #como-llegar, #confirmar (the RSVP panel itself, so links land on the
 * WhatsApp button). Chapters carry `data-chapter` (1-3) for the motion layer.
 * Each photo appears once (the intro curtain reuses the hero download).
 */
import { getImage } from 'astro:assets';
import heroFairy from '../assets/photos/hero-fairy.jpg';
import ChapterScreen from '../components/ChapterScreen.astro';
import Closing from '../components/Closing.astro';
import EventDetails from '../components/EventDetails.astro';
import Fairies from '../components/Fairies.astro';
import Hero from '../components/Hero.astro';
import Intro from '../components/Intro.astro';
import InvitationPanel from '../components/InvitationPanel.astro';
import RsvpPanel from '../components/RsvpPanel.astro';
import SideNav from '../components/SideNav.astro';
import bandLandscape from '../assets/photos/band-landscape.jpg';
import closingLandscape from '../assets/photos/closing-landscape.jpg';
import { copy, event } from '../data/event';
import { formatEventDate } from '../lib/event-date';
import { buildWhatsAppUrl } from '../lib/whatsapp';
import Base from '../layouts/Base.astro';

const date = formatEventDate(event.startsAt, event.timeZone);
const description = [
  `${copy.hero.eyebrow} ${event.childName}`,
  date.dayLabel,
  date.timeLabel,
  event.venue.name,
].join(copy.dateTimeSeparator);
const whatsappUrl = buildWhatsAppUrl(event.whatsapp.digits, event.rsvp.message);

// Social preview: 1200x630 crop of the hero photo (1672x941, downscaled only),
// keeping Renata's face: the crop trims ~30px from its top and bottom.
const OG_WIDTH = 1200;
const OG_HEIGHT = 630;
const ogImage = await getImage({
  src: heroFairy,
  width: OG_WIDTH,
  height: OG_HEIGHT,
  fit: 'cover',
  position: 'center', // sharp keyword; the face stays in frame
  format: 'jpeg',
  quality: 82,
});
const ogImageUrl = new URL(ogImage.src, Astro.site ?? Astro.url).href;
---

<Base
  title={copy.documentTitle}
  description={description}
  image={{ url: ogImageUrl, alt: copy.hero.photoAlt, width: OG_WIDTH, height: OG_HEIGHT }}
>
  <SideNav />
  <main class="invitation">
    <Intro />

    <div id="inicio" class="chapter chapter--1" data-chapter="1">
      <Hero date={date} />
      <InvitationPanel />
    </div>

    <div class="chapter chapter--2" data-chapter="2">
      <ChapterScreen
        photo={bandLandscape}
        alt={copy.chapterDay.photoAlt}
        focus="46% 50%"
        narrowFocus="35% 50%"
        eyebrow={copy.chapterDay.eyebrow}
        title={copy.chapterDay.title}
        titleSize="clamp(56px, 14vw, 128px)"
      />
      <EventDetails dayLabel={date.dayLabel} timeLabel={date.timeLabel} />
    </div>

    <div class="chapter chapter--3" data-chapter="3">
      <ChapterScreen
        photo={closingLandscape}
        alt={copy.chapterRsvp.photoAlt}
        focus="38% 40%"
        narrowFocus="6% 50%"
        eyebrow={copy.chapterRsvp.eyebrow}
        title={copy.chapterRsvp.title}
        titleSize="clamp(52px, 13vw, 120px)"
      />
      <RsvpPanel whatsappUrl={whatsappUrl}>
        <Closing date={date} />
      </RsvpPanel>
    </div>
  </main>

  <!-- Fairy-dust particles (tap anywhere) are drawn here by src/scripts/fairy-dust. -->
  <div class="fairy-dust" data-fairy-dust aria-hidden="true"></div>
  <!-- Fairies that fly out when the invitation opens (src/scripts/fairies). -->
  <Fairies />
</Base>

<script>
  import '../scripts/main';
</script>

<style>
  .invitation {
    position: relative;
  }

  .chapter {
    position: relative;
  }

  /* Later chapters paint over earlier ones, as in V3. */
  .chapter--2 {
    z-index: 4;
  }

  .chapter--3 {
    z-index: 5;
  }

  .fairy-dust {
    position: fixed;
    inset: 0;
    z-index: 30;
    pointer-events: none;
  }

  /* The intro burst plays above the curtain (z-index 40) while it opens. */
  :global(html.intro-opening) .fairy-dust {
    z-index: 45;
  }

  .fairy-dust :global(canvas) {
    display: block;
    pointer-events: none !important;
  }
</style>
